---
const { name, size = 'mid' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<span class={`oddico ${size}`}><img class="l" src={`${b}/icons/light/${name}.svg`} alt="" width="48" height="48" /><img class="d" src={`${b}/icons/dark/${name}.svg`} alt="" width="48" height="48" /></span>
